<mxCell id="iface-ICustomerService" value="&amp;laquo;interface&amp;raquo; ICustomerService (CO2)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2A44;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1460" y="100" width="540" height="217" as="geometry" /></mxCell>
<mxCell id="iface-ICustomerService-ops" value="+ search(searchTerm) : List&amp;lt;Customer&amp;gt;&lt;br&gt;+ createProfile(fullName, email, phone, address, dob, language) : Customer&lt;br&gt;+ updateProfile(customerId, fullName, email, phone, address, language) : void&lt;br&gt;+ verifyIdentity(customerId, dob, bookingRef) : boolean&lt;br&gt;+ getTravelHistory(customerId) : List&amp;lt;Booking&amp;gt;&lt;br&gt;+ logRequest(customerId, category, priority, description, channel) : ServiceRequest&lt;br&gt;+ logComplaint(customerId, category, priority, description, channel) : Complaint&lt;br&gt;+ getServiceRequests(customerId) : List&amp;lt;ServiceRequest&amp;gt;&lt;br&gt;+ assignTo(requestId, staff, performedBy) : void&lt;br&gt;+ changeStatus(requestId, newStatus, performedBy) : boolean&lt;br&gt;+ addResolutionNote(requestId, note) : void&lt;br&gt;+ escalate(requestId, to, reason, performedBy) : void&lt;br&gt;+ getAuditTrail(requestId) : List&amp;lt;RequestStatusChange&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1F2A44;" vertex="1" parent="iface-ICustomerService"><mxGeometry y="30" width="540" height="187" as="geometry" /></mxCell>
